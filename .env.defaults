# 无隐私的默认值（同名环境变量 / .env 覆盖这里的值）
# 凭据放同目录的 .env（私人库，同样入库）；这里只是键位对照，值全为空
MARKET_TEST_BASE_URL=http://localhost:8811
MARKET_PROD_BASE_URL=https://tomo.vocallabs.cn

# —— 角色语音合成（.claude/skills/make-character/tts.js，Fish Audio）——
FISH_AUDIO_API_KEY=
# 本地代理，如 http://127.0.0.1:7897
FISH_PROXY=

# —— 角色库上传（.claude/skills/make-character/upload.js；baseUrl 见上面的默认值）——
# 测试环境（upload.js 默认 --env test）
MARKET_TEST_USERNAME=
MARKET_TEST_PASSWORD=
# 生产环境（upload.js --env prod，需加 --yes 确认）
MARKET_PROD_USERNAME=
MARKET_PROD_PASSWORD=
# proxy 可选（同 FISH_PROXY 用法）
MARKET_PROXY=
